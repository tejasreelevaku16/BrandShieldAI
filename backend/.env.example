# ==============================================================================
# BrandShield AI Backend - Environment Configuration Template
# ==============================================================================

# Server Port (automatically injected by Render, Railway, Fly.io, Heroku)
PORT=8000

# Server Host Binding (0.0.0.0 is required in container/cloud environments)
HOST=0.0.0.0

# Database Connection URL:
# 1. Local SQLite / Persistent Volume Disk (Recommended for fastest zero-config setup):
DATABASE_URL=sqlite:///./brandshield.db
# 2. Managed PostgreSQL (Neon, Supabase, Railway, Render Postgres):
# DATABASE_URL=postgresql://username:password@ep-host.region.provider.com:5432/brandshield

# CORS Allowed Origins:
# Comma-separated list of allowed frontend origins, or * for open access:
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app
